<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
	failOnNotice="true"
	cacheDirectory=".phpunit.cache"
	>
	<testsuites>
		<testsuite name="RayEtun Events Calendar">
			<directory suffix="Test.php">tests</directory>
		</testsuite>
	</testsuites>

	<source>
		<include>
			<directory>rayetun-events-calendar/includes</directory>
		</include>
	</source>
</phpunit>
